{
  "appId": "com.ranit.randrop",
  "productName": "RanDrop",
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "dist/**/*",
    "desktop/**/*",
    "package.json",
    "!node_modules/**/*",
    "!android/**/*",
    "!ios/**/*",
    "!.expo/**/*"
  ],
  "asar": true,
  "extraMetadata": {
    "main": "desktop/main.js"
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "desktop/icon.png"
  }
}
